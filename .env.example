# Copy to .env.local (gitignored) and put real values there, or in Vercel's
# project settings. Never put real values in this file: the repo is public.
# All of these are server-only (never prefix them with NEXT_PUBLIC_), except the
# NEXT_PUBLIC_DEVICE_* experiment switches at the end, which must stay unset in production.
# What each one does: the "Environment variables" table in docs/AUTH.md.

# Generate with: openssl rand -base64 32 (a different value per environment)
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

BETTER_AUTH_URL=http://localhost:3000

# On Vercel, use Neon's pooled connection string (Neon console, "Connect").
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Encrypts user data in the database (src/lib/crypto/fieldEncryption.ts).
# Generate with: openssl rand -base64 32 (a different value per environment).
# Keep a backup outside the repo: losing it makes the encrypted data unreadable.
ENCRYPTION_MASTER_KEY=replace-with-output-of-openssl-rand-base64-32

# Optional; only tests set this, to point at a mock Pwned Passwords API.
# PWNED_PASSWORDS_API_URL=

# AI learner (Pip). Any OpenAI-compatible provider works. Leave LLM_API_KEY empty
# and Pip falls back to the scripted demo learner. Free option: Groq
# (console.groq.com → API Keys); make your own key, don't share one.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Optional: a model per role. Free tiers give each model its own quota, so splitting
# them roughly doubles how many turns a key can serve. Both default to LLM_MODEL.
# LLM_MODEL_ASSESSOR=openai/gpt-oss-120b
# LLM_MODEL_PIP=openai/gpt-oss-20b

# On-device Pip (docs/AI_LEARNER.md): a local experiment, off unless both are 1.
# Never set these in Vercel.
# DEVICE_PIP_EXPERIMENT=1
# NEXT_PUBLIC_DEVICE_PIP_EXPERIMENT=1
# NEXT_PUBLIC_DEVICE_PIP_URL=/webllm/pip-v10-q0f16-MLC/
