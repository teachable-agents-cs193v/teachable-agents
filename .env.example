# Environment variables for the app. Copy this file to .env.local (gitignored)
# and put real values there, or in Vercel's project settings. Never put real
# values in this file: it is committed to a public repo.
#
# None of these are read yet. Auth starts using them in issue #11; see
# docs/AUTH.md. All are server-only: never prefix any of them with NEXT_PUBLIC_.

# Signs session cookies. At least 32 random characters, different for each
# environment. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# The app's base URL, used for origin checks on auth endpoints.
BETTER_AUTH_URL=http://localhost:3000

# Postgres connection string. Locally, a throwaway Postgres; on Vercel, Neon's
# pooled connection string (from the Neon console's "Connect" dialog).
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Optional. Tests point this at a local mock of the Pwned Passwords API.
# Leave it unset everywhere else.
# PWNED_PASSWORDS_API_URL=
