#!/bin/sh
# Blocks a commit whose staged files contain database credentials or other
# secrets. Scans the full staged (index) version of every added, copied,
# modified or renamed file, not the working tree, so it checks exactly what
# would be committed. Whole files are scanned rather than just the changed
# lines so that a file renamed without edits is still checked.
set -eu
. "$(git rev-parse --show-toplevel)/.githooks/lib.sh"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

git diff --cached --name-only -z --diff-filter=ACMR >"$tmp/.files"
# Nothing staged with content to check (e.g. only deletions).
[ -s "$tmp/.files" ] || exit 0

mkdir "$tmp/staged"
git checkout-index --prefix="$tmp/staged/" -z --stdin <"$tmp/.files"

rc=0
STRIP="$tmp/staged/" run_gitleaks dir "$tmp/staged" || rc=$?
[ "$rc" -eq 0 ] && exit 0

if [ "$rc" -eq 2 ]; then
  echo >&2
  echo "Commit blocked: the staged files above look like they contain credentials." >&2
  echo "Unstage them (git restore --staged <file>), move the value into .env.local" >&2
  echo "(gitignored) and read it with process.env, then commit again." >&2
  echo "If it is a placeholder, use one like postgres://user:password@host/db." >&2
fi
exit 1
